{
  "name": "@tummycrypt/tinyland-credentials-generator",
  "version": "0.2.2",
  "private": true,
  "description": "Professional credentials card generator with QR codes for TOTP setup",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "author": "Tinyland.dev",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyland-inc/tinyland-credentials-generator.git"
  },
  "dependencies": {
    "sharp": "^0.33.0",
    "qrcode": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "publint": "^0.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/tinyland-inc/tinyland-credentials-generator",
  "bugs": {
    "url": "https://github.com/tinyland-inc/tinyland-credentials-generator/issues"
  }
}
